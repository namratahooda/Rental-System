generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client-stage6"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum Role {
  STUDENT
  ADMIN
}
enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ListingType {
  RENT
  SELL
}
enum ListingStatus {
  ACTIVE
  PAUSED
  REMOVED
  SOLD
}
enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}
enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}
enum BookingPriceUnit {
  DAILY
  MONTHLY
}
enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
  DECLINED
  CANCELLED
}
enum PurchaseStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  PAYMENT_PENDING
  COMPLETED
}
enum PurchaseOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}
enum SubscriptionListingStatus {
  ACTIVE
  PAUSED
  REMOVED
}
enum MembershipStatus {
  PENDING
  APPROVED
  PAYMENT_PENDING
  ACTIVE
  REJECTED
  CANCELLED
  EXPIRED
}
enum TransactionType {
  PURCHASE
  SUBSCRIPTION
  RENTAL_DEPOSIT
}
enum TransactionStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}
enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}
enum DepositStatus {
  HELD
  RETURNED
  DEDUCTED
}
enum ReviewStatus {
  VISIBLE
  HIDDEN
}
enum NeedRequestType {
  RENT
  BUY
  SUBSCRIPTION
}
enum NeedRequestStatus {
  OPEN
  OFFERS_RECEIVED
  OFFER_ACCEPTED
  FULFILLED
  EXPIRED
  CANCELLED
}
enum NeedOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isApproved   Boolean  @default(true)
  suspended    Boolean  @default(false)
  profilePhoto String?
  college      String   @default("IIIT Allahabad")
  department   String?
  yearOfStudy  String?
  contactInfo  String?
  createdAt    DateTime @default(now())
  listings     Listing[]
  wishlist     Wishlist[]
  accessRequest ExternalAccessRequest?
  renterBookings Booking[] @relation("BookingRenter")
  ownerBookings Booking[] @relation("BookingOwner")
  notifications Notification[]
  purchaseRequests PurchaseRequest[] @relation("PurchaseBuyer")
  salesRequests PurchaseRequest[] @relation("PurchaseSeller")
  subscriptionListings SubscriptionListing[]
  subscriptionMemberships SubscriptionMembership[]
  transactions Transaction[]
  refundsRequested Refund[] @relation("RefundRequester")
  refundsApproved Refund[] @relation("RefundApprover")
  refundsRejected Refund[] @relation("RefundRejector")
  refundsProcessed Refund[] @relation("RefundProcessor")
  reviewsGiven Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewSubject")
  conversationLinks ConversationParticipant[]
  messages Message[]
  auditLogs AuditLog[]
  reportsFiled MarketplaceReport[] @relation("ReportReporter")
  reportsReviewed MarketplaceReport[] @relation("ReportReviewer")
  reportsAgainst MarketplaceReport[] @relation("ReportReportedUser")
  needRequests NeedRequest[] @relation("NeedRequester")
  needOffers NeedOffer[] @relation("NeedOfferer")
}
model ExternalAccessRequest {
  id         String       @id @default(cuid())
  userId     String       @unique
  reason     String?
  status     AccessStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  active   Boolean   @default(true)
  listings Listing[]
  needRequests NeedRequest[]
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model AuditLog {
  id              String   @id @default(cuid())
  administratorId String
  actionType      String
  entityType      String
  entityId        String
  description     String
  beforeStatus    String?
  afterStatus     String?
  createdAt       DateTime @default(now())
  administrator  User     @relation(fields: [administratorId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([administratorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model MarketplaceReport {
  id               String       @id @default(cuid())
  reporterId       String
  reportedUserId   String?
  listingId        String?
  subscriptionListingId String?
  transactionId    String?
  reason           String
  description      String
  status           ReportStatus @default(OPEN)
  adminResponse    String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  reporter         User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser     User? @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  listing          Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  subscriptionListing SubscriptionListing? @relation(fields: [subscriptionListingId], references: [id], onDelete: SetNull)
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reviewedBy       User? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([listingId])
  @@index([reportedUserId])
  @@index([subscriptionListingId])
  @@index([transactionId])
}
model Listing {
  id            String        @id @default(cuid())
  ownerId       String
  categoryId    String
  type          ListingType
  title         String
  description   String
  quantity      Int           @default(1)
  condition     Condition
  dailyPrice    Float?
  monthlyPrice  Float?
  deposit       Float?
  salePrice     Float?
  pickupLocation String
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id])
  images        ListingImage[]
  wishlistedBy  Wishlist[]
  bookings      Booking[]
  reports       MarketplaceReport[]
  purchaseRequests PurchaseRequest[]
  conversations Conversation[]
  needOffers NeedOffer[]
  @@index([type, status, createdAt])
  @@index([categoryId])
}

model Booking {
  id              String            @id @default(cuid())
  listingId       String
  renterId        String
  ownerId         String
  startDate       DateTime
  endDate         DateTime
  quantity        Int
  priceUnit       BookingPriceUnit
  rentalUnits     Int
  originalAmount  Int
  agreedAmount    Int
  status          BookingStatus     @default(PENDING)
  renterMessage   String?
  idempotencyKey  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  approvedAt      DateTime?
  completedAt     DateTime?
  listing         Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  renter          User              @relation("BookingRenter", fields: [renterId], references: [id], onDelete: Restrict)
  owner           User              @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  negotiation     Negotiation?
  notifications   Notification[]
  depositRecord    DepositRecord?
  transactions     Transaction[]
  reviews          Review[]
  needOffer        NeedOffer? @relation("NeedOfferBooking")

  @@unique([renterId, idempotencyKey])
  @@index([listingId, status, startDate, endDate])
  @@index([renterId, status, createdAt])
  @@index([ownerId, status, createdAt])
}

model Negotiation {
  id                         String            @id @default(cuid())
  bookingId                  String            @unique
  proposedDiscountPercentage Int
  proposedAmount             Int
  status                     NegotiationStatus @default(PENDING)
  message                    String?
  createdAt                  DateTime          @default(now())
  respondedAt                DateTime?
  booking                    Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Notification {
  id             String   @id @default(cuid())
  recipientId    String
  bookingId      String?
  purchaseRequestId String?
  membershipId   String?
  transactionId  String?
  conversationId String?
  needRequestId String?
  needOfferId String?
  title          String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  recipient      User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  membership     SubscriptionMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  needRequest NeedRequest? @relation(fields: [needRequestId], references: [id], onDelete: SetNull)
  needOffer NeedOffer? @relation(fields: [needOfferId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@index([bookingId])
  @@index([purchaseRequestId])
  @@index([membershipId])
  @@index([transactionId])
  @@index([conversationId])
  @@index([needRequestId])
  @@index([needOfferId])
}

model PurchaseRequest {
  id              String         @id @default(cuid())
  listingId       String
  buyerId         String
  sellerId        String
  originalAmount  Int
  agreedAmount    Int
  quantity        Int @default(1)
  status          PurchaseStatus @default(PENDING)
  message         String?
  offerCount      Int            @default(0)
  idempotencyKey  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  listing         Listing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer           User           @relation("PurchaseBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller          User           @relation("PurchaseSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  offers          PurchaseOffer[]
  transactions    Transaction[]
  notifications   Notification[]
  reviews         Review[]
  conversations   Conversation[]
  needOffer NeedOffer? @relation("NeedOfferPurchase")
  @@unique([buyerId, idempotencyKey])
  @@index([listingId, status, createdAt])
  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
}

model PurchaseOffer {
  id             String              @id @default(cuid())
  requestId      String
  proposedAmount Int
  message        String?
  status         PurchaseOfferStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  respondedAt    DateTime?
  request        PurchaseRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
}

model SubscriptionCategory {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  active   Boolean @default(true)
  listings SubscriptionListing[]
}

model SubscriptionListing {
  id             String @id @default(cuid())
  ownerId        String
  categoryId     String
  name           String
  description    String
  plan           String
  totalSeats     Int
  availableSeats Int
  durationDays   Int
  startDate      DateTime
  expiryDate     DateTime
  pricePerSeat   Int
  restrictions   String?
  terms          String?
  status         SubscriptionListingStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category       SubscriptionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  memberships    SubscriptionMembership[]
  conversations  Conversation[]
  reports        MarketplaceReport[]
  needOffers NeedOffer[]
  @@index([status, categoryId, createdAt])
  @@index([ownerId, status])
  @@index([expiryDate])
}

model SubscriptionMembership {
  id          String @id @default(cuid())
  listingId   String
  userId      String
  amount      Int
  seatCount   Int @default(1)
  startDate   DateTime
  expiryDate  DateTime
  status      MembershipStatus @default(PENDING)
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  listing     SubscriptionListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  notifications Notification[]
  reviews Review[]
  needOffer NeedOffer? @relation("NeedOfferMembership")
  @@unique([listingId, userId])
  @@index([userId, status, expiryDate])
  @@index([listingId, status, createdAt])
}

model Transaction {
  id                String @id @default(cuid())
  userId            String
  purchaseRequestId String?
  membershipId      String?
  bookingId         String?
  type              TransactionType
  amount            Int
  currency          String @default("INR")
  status            TransactionStatus @default(INITIATED)
  paymentMethod     String @default("SIMULATED")
  idempotencyKey    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  membership        SubscriptionMembership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  booking           Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds           Refund[]
  notifications     Notification[]
  reviews           Review[]
  reports           MarketplaceReport[]
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([purchaseRequestId])
  @@index([membershipId])
  @@index([bookingId])
}

model Refund {
  id            String @id @default(cuid())
  transactionId String
  requestedById String
  approvedById  String?
  rejectedById  String?
  processedById String?
  amount        Int
  reason        String
  rejectionReason String?
  status        RefundStatus @default(REQUESTED)
  requestedAt   DateTime @default(now())
  approvedAt    DateTime?
  rejectedAt    DateTime?
  processedAt   DateTime?
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  requestedBy   User @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User? @relation("RefundApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy     User? @relation("RefundRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  processedBy   User? @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  @@index([status, requestedAt])
  @@index([transactionId, status])
}

model DepositRecord {
  id              String @id @default(cuid())
  bookingId       String @unique
  amount          Int
  deductionAmount Int @default(0)
  reason          String?
  status          DepositStatus @default(HELD)
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model Review {
  id                       String @id @default(cuid())
  reviewerId               String
  reviewedUserId           String
  interactionKey           String @unique
  transactionId            String?
  purchaseRequestId        String?
  bookingId                String?
  subscriptionMembershipId String?
  rating                   Int
  comment                  String?
  status                   ReviewStatus @default(VISIBLE)
  createdAt                DateTime @default(now())
  reviewer                 User @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedUser             User @relation("ReviewSubject", fields: [reviewedUserId], references: [id], onDelete: Restrict)
  transaction              Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  purchaseRequest          PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  booking                  Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  subscriptionMembership   SubscriptionMembership? @relation(fields: [subscriptionMembershipId], references: [id], onDelete: Restrict)
  @@index([reviewedUserId, status, createdAt])
  @@index([reviewerId, createdAt])
}

model Conversation {
  id                    String @id @default(cuid())
  key                   String @unique
  relatedListingId      String?
  purchaseRequestId     String?
  subscriptionListingId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  relatedListing        Listing? @relation(fields: [relatedListingId], references: [id], onDelete: SetNull)
  purchaseRequest       PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  subscriptionListing   SubscriptionListing? @relation(fields: [subscriptionListingId], references: [id], onDelete: SetNull)
  participants          ConversationParticipant[]
  messages              Message[]
  notifications         Notification[]
  @@index([updatedAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model NeedRequest {
  id String @id @default(cuid())
  requesterId String
  categoryId String
  title String
  description String
  requestType NeedRequestType
  quantity Int @default(1)
  budgetMin Int
  budgetMax Int
  startDate DateTime?
  endDate DateTime?
  rentalDuration String?
  desiredCondition Condition?
  specifications String?
  subscriptionName String?
  desiredPlan String?
  desiredDurationDays Int?
  seats Int?
  status NeedRequestStatus @default(OPEN)
  expiresAt DateTime
  fulfilledAt DateTime?
  expiryNoticeSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requester User @relation("NeedRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers NeedOffer[]
  notifications Notification[]
  @@index([status, requestType, categoryId, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([expiresAt, status])
}

model NeedOffer {
  id String @id @default(cuid())
  requestId String
  offererId String
  listingId String?
  subscriptionListingId String?
  offeredPrice Int
  availableStartDate DateTime?
  availableEndDate DateTime?
  quantity Int @default(1)
  condition Condition?
  message String?
  terms String?
  status NeedOfferStatus @default(PENDING)
  bookingId String? @unique
  purchaseRequestId String? @unique
  membershipId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request NeedRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerer User @relation("NeedOfferer", fields: [offererId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  subscriptionListing SubscriptionListing? @relation(fields: [subscriptionListingId], references: [id], onDelete: SetNull)
  booking Booking? @relation("NeedOfferBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest? @relation("NeedOfferPurchase", fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  membership SubscriptionMembership? @relation("NeedOfferMembership", fields: [membershipId], references: [id], onDelete: SetNull)
  notifications Notification[]
  @@unique([requestId, offererId, listingId])
  @@unique([requestId, offererId, subscriptionListingId])
  @@index([requestId, status, createdAt])
  @@index([offererId, status, createdAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([userId, listingId])
}
